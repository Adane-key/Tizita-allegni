<%- include('partials/header') %>

<section class="section">
  <div class="container">
    <h1 class="section-title"><%= t('cars_page_title') %></h1>

    <div class="filter-bar">
      <div class="filter-tabs">
        <a href="/cars" class="filter-tab <%= activeType === 'all' ? 'active' : '' %>"><%= t('filter_all') %></a>
        <a href="/cars?type=rent" class="filter-tab <%= activeType === 'rent' ? 'active' : '' %>"><%= t('filter_rent') %></a>
        <a href="/cars?type=sell" class="filter-tab <%= activeType === 'sell' ? 'active' : '' %>"><%= t('filter_sell') %></a>
      </div>
      <form class="search-form" action="/cars" method="GET">
        <% if (activeType !== 'all') { %><input type="hidden" name="type" value="<%= activeType %>" /><% } %>
        <input type="text" name="search" placeholder="<%= t('search_placeholder') %>" value="<%= search %>" />
        <button class="btn btn-outline btn-sm" type="submit"><%= t('search_btn') %></button>
      </form>
    </div>

    <% if (cars.length === 0) { %>
      <div class="empty-state"><%= t('no_cars_found') %></div>
    <% } else { %>
      <div class="car-grid">
        <% cars.forEach(function(car) { %>
          <div class="car-card">
            <a href="/cars/<%= car.id %>" class="car-card-img">
              <img src="<%= car.image %>" alt="<%= lang === 'am' ? car.titleAm : car.titleEn %>" style="width:100%;height:100%;object-fit:cover;" />
            </a>
            <div class="car-card-body">
              <div class="badge-row">
                <% if (car.listingType === 'rent' || car.listingType === 'both') { %>
                  <span class="badge rent"><%= t('for_rent_label') %></span>
                <% } %>
                <% if (car.listingType === 'sell' || car.listingType === 'both') { %>
                  <span class="badge sale"><%= t('for_sale_label') %></span>
                <% } %>
              </div>
              <h3><%= lang === 'am' ? car.titleAm : car.titleEn %></h3>
              <div class="car-meta"><%= car.brand %> &middot; <%= car.model %> &middot; <%= car.year %></div>
              <div class="car-card-footer">
                <div class="plate">
                  <% if (car.listingType === 'rent') { %>
                    <%= car.rentPricePerDay.toLocaleString() %> <span class="unit">ETB<%= t('per_day') %></span>
                  <% } else if (car.listingType === 'sell') { %>
                    <%= car.sellPrice.toLocaleString() %> <span class="unit">ETB</span>
                  <% } else { %>
                    <%= car.rentPricePerDay.toLocaleString() %> <span class="unit">ETB<%= t('per_day') %></span>
                  <% } %>
                </div>
                <a href="/cars/<%= car.id %>" class="btn btn-green btn-sm"><%= t('view_details') %></a>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
